# Jenkins plugin binaries (downloaded from GH releases at image-build time)
image/percona-plugins/*.hpi

# Terraform / OpenTofu
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfplan
# Named TF plan files like `tfplan.bootstrap-token` — generated by
# `tofu plan -out=tfplan.<name>` workflows; never commit.
tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local-only tfvars (per-developer overrides like aws_profile)
*.auto.tfvars
!*.auto.tfvars.example
backend.hcl

# tflint cache
.tflint.d/

# Local-only dotfiles
.envrc
.direnv/
.env
.env.*
!.env.example

# Secrets that should never land in git
*.pem
*.key
secrets/
*.kubeconfig

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Tooling caches
.pre-commit-cache/
.tflint-cache/
.cache/
node_modules/

# Helm chart deps — `helm dep update` materialises these locally during
# `helm template`/`helm lint`. ArgoCD does its own dep update at sync time;
# committing them just bloats the repo with vendored upstream charts.
resources/addons/*/Chart.lock
resources/addons/*/charts/

# Local kubectl context dumps
kubeconfig-*.yaml
