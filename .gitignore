# Jenkins plugin binaries (fetched from GitHub Releases by fetch-hpis.sh at
# image-build time, staged as <id>.jpi; never commit the binaries themselves).
images/jenkins/percona-plugins/*.jpi
images/jenkins/percona-plugins/*.hpi
!images/jenkins/percona-plugins/.gitkeep

# Terraform / OpenTofu
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfplan
# Named TF plan files like `tfplan.bootstrap-token` — generated by
# `tofu plan -out=tfplan.<name>` workflows; never commit.
tfplan.*
# Bare saved plan written by `just tf-plan` (terraform/tfplan).
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local-only tfvars (per-developer overrides) plus any suffixed backup copy
# (.bak-<timestamp>, .orig, .old). Order matters: gitignore is last-match-wins,
# so the example negation must stay AFTER the backup pattern, or
# *.auto.tfvars.* would re-ignore the tracked example file.
*.auto.tfvars
*.auto.tfvars.*
!*.auto.tfvars.example
backend.hcl

# Local one-off tofu experiment roots (scratch stacks with local state).
# Standing leak guard: anything durable gets promoted into terraform/ proper
# via a reviewed PR, as the molecule-tests adoption was (terraform/molecule-tests.tf).
terraform/_oneoff/

# tflint cache
.tflint.d/

# Local-only dotfiles
.envrc
.direnv/
.env
.env.*
!.env.example

# Secrets that should never land in git
*.pem
*.key
secrets/
*.kubeconfig

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.bak-*

# Tooling caches
.pre-commit-cache/
.tflint-cache/
.cache/
node_modules/
__pycache__/
*.pyc
*.egg-info/
.serena/

# Helm chart deps — `helm dep update` materialises these locally during
# `helm template`/`helm lint`. ArgoCD does its own dep update at sync time;
# committing them just bloats the repo with vendored upstream charts.
resources/addons/*/Chart.lock
resources/addons/*/charts/
resources/jenkins/*/Chart.lock
resources/jenkins/*/charts/

# Local kubectl context dumps
kubeconfig-*.yaml
