{
  "uid": "aws-alb",
  "title": "AWS / Load Balancers",
  "description": "Traffic + target health for the platform ALBs/NLB from CloudWatch via YACE (ADR 0034), plus the in-cluster ALB path.",
  "tags": [
    "aws",
    "alb",
    "lgtm"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-12h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "lb",
        "label": "load balancer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(aws_applicationelb_request_count_sum, dimension_LoadBalancer)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "CloudWatch data **lags 5-12 min** (period 300s + delay 120s + scrape cadence; scrape-time stamps). Every `aws_*` series is a **gauge holding the newest 5-min bucket**: never `rate()` them; per-second rates divide by 300. Exporter: `cloudwatch-exporter` addon (ADR 0034)."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "ALB traffic",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests/s",
      "description": "RequestCount Sum over the 5-min bucket, divided by 300.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (dimension_LoadBalancer) (aws_applicationelb_request_count_sum{dimension_LoadBalancer=~\"$lb\"}) / 300",
          "legendFormat": "{{dimension_LoadBalancer}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5XX ratio",
      "description": "ELB-generated plus target 5XX as a share of all requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * sum by (dimension_LoadBalancer) (aws_applicationelb_httpcode_elb_5_xx_count_sum{dimension_LoadBalancer=~\"$lb\"} + aws_applicationelb_httpcode_target_5_xx_count_sum{dimension_LoadBalancer=~\"$lb\"}) / clamp_min(sum by (dimension_LoadBalancer) (aws_applicationelb_request_count_sum{dimension_LoadBalancer=~\"$lb\"}), 1)",
          "legendFormat": "{{dimension_LoadBalancer}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Target HTTP codes/s",
