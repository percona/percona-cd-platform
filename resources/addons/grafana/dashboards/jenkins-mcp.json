      "title": "Batch tool latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "p95 per batch tool against its own budget: get_build_walk stages 45 s, wait_for_build 60 s, find_items 30 s, grep glob and search_item_configs 120 s.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
