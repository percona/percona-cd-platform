      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Headline: most active gateway users over the dashboard range, from the audit log.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "topk(10, sum by (preferred_username) (count_over_time({instance=~\"jenkins-mcp/.+\"} |= \"mcp_tool_call\" | json | __error__=\"\" | preferred_username!=\"\" [$__range])))",
          "legendFormat": "{{preferred_username}}",
          "instant": true,
          "queryType": "instant"
