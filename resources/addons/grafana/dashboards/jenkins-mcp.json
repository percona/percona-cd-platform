    {
      "id": 28,
      "title": "Errors by tool and class (range)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Distinct failed calls by tool and exception class. error_module (0.10.0+) tells a bad argument (fastmcp.exceptions) from a Jenkins or payload failure.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count by (tool, error, error_module) (sum by (tool, error, error_module, request_id) (count_over_time({instance=~\"jenkins-mcp/.+\"} |= \"mcp_tool_call\" | json | __error__=\"\" | master=~\"$master\" | tool=~\"$tool\" | status=\"error\" [$__range])))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "tool": "Tool",
              "error": "Class",
              "error_module": "Module",
              "Value": "Count",
              "Value #A": "Count"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Count",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "-"
        },
        "overrides": []
      }
    },
    {
      "id": 29,
      "title": "Failing arguments (range)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "First failing argument of each bad call (pydantic loc and type, never the value), from the 0.10.0 audit field error_detail. Points at docstrings or aliases worth adding. An argument the tool does not take shows as unexpected_keyword_argument.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
