    {
      "id": 6,
      "title": "Authz denials (range)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Denials in the dashboard range: last sample per series minus the value at the range start. increase() undercounts here because each counter child is created on its first event, so the first sample of every series born in the range (every pod replacement recreates them all) is never counted.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum(last_over_time(mcp_authz_denied_total{namespace=\"jenkins-mcp\"}[$__range])) - (sum(mcp_authz_denied_total{namespace=\"jenkins-mcp\"} offset ${__range_s}s) or vector(0)) or vector(0)",
          "instant": true,
          "legendFormat": ""
        }
      ]
    },
