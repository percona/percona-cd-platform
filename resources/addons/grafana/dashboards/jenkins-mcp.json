    {
      "id": 31,
      "title": "Batch tool calls (range)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Adoption of the 0.10.0 batch tools, each replacing a per-master, per-build or per-file loop. The glob row counts grep_build_artifact calls whose relative_path is a glob. Rows appear once a tool is used in the range.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "legendFormat": "{{tool}}",
          "expr": "count by (tool) (sum by (tool, request_id) (count_over_time({instance=~\"jenkins-mcp/.+\"} |= \"mcp_tool_call\" | json | __error__=\"\" | tool=~\"get_build_walk|wait_for_build|find_items|search_item_configs|stop_builds\" [$__range])))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "legendFormat": "grep_build_artifact (glob)",
          "expr": "label_replace(count(sum by (request_id) (count_over_time({instance=~\"jenkins-mcp/.+\"} |= \"mcp_tool_call\" | json | __error__=\"\" | tool=\"grep_build_artifact\" | args_relative_path=~\".*[*?\\\\[].*\" [$__range]))), \"tool\", \"grep_build_artifact (glob)\", \"\", \"\")"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "tool": "Tool",
              "Value #A": "Count",
              "Value #B": "Count",
              "Value": "Count"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Count",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
