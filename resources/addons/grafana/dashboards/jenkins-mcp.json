          },
          "expr": "count by (tool, loc, etype) (sum by (tool, loc, etype, request_id) (count_over_time({instance=~\"jenkins-mcp/.+\"} |= \"mcp_tool_call\" | json tool=\"tool\", status=\"status\", master=\"master\", request_id=\"request_id\", loc=\"error_detail[0].loc\", etype=\"error_detail[0].type\" | status=\"error\" | loc!=\"\" | master=~\"$master\" | tool=~\"$tool\" [$__range])))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "tool": "Tool",
              "loc": "Argument",
              "etype": "Error type",
              "Value": "Count",
              "Value #A": "Count"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Count",
                "desc": true
              }
            ]
          }
        }
