{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alarms",
        "type": "dashboard"
      }
    ]
  },
  "description": "Hetzner Cloud Jenkins plugin (v103.percona.13+): circuit breakers, provisioning latency, rate-limit headroom, API health, capacity vs cap, anomaly counters, and correlated SLF4J logs from /hetzner-prometheus and Loki. v2 (2026-05-12) fixes the idle-fleet success-rate gauge, the Loki level regex, the pending-vs-reap axis collision, the empty-stat label loss on anomaly counters, and adds API and capacity visibility.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 210,
      "title": "Stuck builds per master (24h+ threshold)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Count of builds that crossed the 24h hang threshold in the last 24 hours. Emitted by HungBuildDetector PeriodicWork (v103.percona.17+). Healthy fleet is all zeros. Increments fire ONCE per build crossing the threshold, deduped via in-plugin cache.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (master) (increase(hetzner_stuck_builds_total{threshold_hours=\"24\",master=~\"$master\",master=~\".+\\\\.cd\"}[24h]))",
          "legendFormat": "{{master}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "valueMode": "color",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "min": 0,
          "unit": "short"
        }
      }
    },
    {
      "id": 211,
      "title": "Oldest building build per master (age in seconds)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "For each master, the elapsed age of the longest-running building build right now. Emitted by HungBuildDetector PeriodicWork (v103.percona.17+). Green up to 12h, yellow up to 24h, red above. Cross-reference with `jenkins admin -i <master> incidents` for triage.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "max by (master) (hetzner_oldest_build_age_seconds{master=~\"$master\",master=~\".+\\\\.cd\"})",
          "legendFormat": "{{master}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "master": "Master",
              "Value": "Oldest age"
            },
            "indexByName": {
              "master": 0,
              "Value": 1
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Master"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Oldest age"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 43200
                    },
                    {
                      "color": "red",
                      "value": 86400
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 200,
      "title": "Active workers per master",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Live count of Hetzner worker nodes currently provisioned per Jenkins master. Bar length is proportional to count; color shifts to yellow above 70% of master cap, red above 90%. Sorted descending by count.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (master) (hetzner_running_servers{master=~\"$master\",master=~\".+\\\\.cd\"})",
          "legendFormat": "{{master}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "valueMode": "color",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "max": 100,
          "min": 0,
          "unit": "short"
        }
      }
    },
    {
      "id": 201,
      "title": "Fleet capacity roll-up",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "One row per master with running/pending/cap/utilization side by side. Shows where the fleet has provisioning headroom and where it is at the ceiling. Masters that have never provisioned Hetzner workers (e.g. pmm.cd) will show empty values for running and pending.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (master) (hetzner_running_servers{master=~\"$master\",master=~\".+\\\\.cd\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "B",
          "expr": "sum by (master) (hetzner_provisioning_pending{master=~\"$master\",master=~\".+\\\\.cd\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "C",
          "expr": "sum by (master) (hetzner_instance_cap{master=~\"$master\",master=~\".+\\\\.cd\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "D",
          "expr": "100 * sum by (master) (hetzner_running_servers{master=~\"$master\",master=~\".+\\\\.cd\"}) / clamp_min(sum by (master) (hetzner_instance_cap{master=~\"$master\",master=~\".+\\\\.cd\"}), 1)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "master",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true
            },
            "renameByName": {
              "master": "Master",
              "Value #A": "Running",
              "Value #B": "Pending",
              "Value #C": "Cap",
              "Value #D": "Util %"
            },
            "indexByName": {
              "master": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Master"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Util %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 70
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 202,
      "title": "Worker templates per location",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "How many configured Hetzner worker templates the fleet has per Hetzner datacenter (nbg1, fsn1, hel1, ash, hil, sin). Compare with the DC circuit breaker panel to spot DCs that are configured but consistently failing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "count by (location) (hetzner_template_info{master=~\"$master\",master=~\".+\\\\.cd\"})",
          "legendFormat": "{{location}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "location": "Location",
              "Value": "Templates"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Location"
              }
            ]
          }
        }
      ],
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "always",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "fillOpacity": 80,
            "lineWidth": 1
          }
        }
      }
    },
    {
      "id": 203,
      "title": "Running workers per master over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Hetzner worker node count per master over the dashboard time range. Each line is a master; the y-value is the live count of running servers at that instant. Lines rise when workers spawn, fall when reaped. v103.percona.16+ refreshes the gauge every minute regardless of provisioning activity; pre-.16 masters can show stale flat lines (see panel 200 status). Pairs with panel 200 (instant view) and panel 201 (per-master capacity table).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (master) (hetzner_running_servers{master=~\"$master\",master=~\".+\\\\.cd\"})",
          "legendFormat": "{{master}}"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "axisPlacement": "auto",
            "spanNulls": true
          },
          "unit": "short",
          "min": 0,
          "decimals": 0
        }
      }
    },
    {
      "id": 1,
      "title": "DC circuit breaker state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "0 = CLOSED (healthy), 1 = HALF_OPEN (probing), 2 = OPEN (skipping). One series per master/location.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20,
            "spanNulls": true
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CLOSED",
                  "color": "green"
                },
                "1": {
                  "text": "HALF_OPEN",
                  "color": "yellow"
                },
                "2": {
                  "text": "OPEN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "min": 0,
          "max": 2
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (master, location) (hetzner_dc_circuit_breaker_state{master=~\"$master\"})",
          "legendFormat": "{{master}} {{location}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Provisioning success rate (5m)",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Successful provisions / total provision attempts, last 5 minutes. Shows 'no attempts' (not red) when the fleet is idle.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "noValue": "no attempts"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum(rate(hetzner_provision_attempts_total{master=~\"$master\",outcome=\"success\"}[5m]))\n/\nsum(rate(hetzner_provision_attempts_total{master=~\"$master\"}[5m]))\nunless sum(rate(hetzner_provision_attempts_total{master=~\"$master\"}[5m])) == 0"
        }
      ]
    },
    {
      "id": 3,
      "title": "Provision latency p95 by template (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "95th percentile of hetzner_provision_duration_seconds_bucket, grouped by template label.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum by (template, le) (rate(hetzner_provision_duration_seconds_bucket{master=~\"$master\"}[5m])))",
          "legendFormat": "{{template}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "API rate-limit headroom",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "One line per Jenkins master = one independent Hetzner API token bucket (3600 req/hr per token, rolling 1h window). Each master has its own token, so red on one line does NOT affect the others. Green >=500 (healthy). Yellow 200-500 (provision storm forming, ~3-9 min headroom). Red <200 (near exhaustion; at 0 the plugin self-suppresses provisions for 60s on that master). Every API call counts, including rejected resource_unavailable create_server (e.g. CAX stockout).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 3600,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 0,
            "gradientMode": "none",
            "lineWidth": 2
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "green",
                "value": 500
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "min by (credentials_id, master) (hetzner_api_rate_limit_remaining{master=~\"$master\"})",
          "legendFormat": "{{master}} {{credentials_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pending provisions vs orphan reap rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "In-flight provisions (left axis, count) overlaid with orphan-server reap rate (right axis, events/sec). A growing gap suggests provision attempts are leaking.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisLabel",
                "value": "reap rate (events/sec)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "left"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisLabel",
                "value": "pending"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (master) (hetzner_provisioning_pending{master=~\"$master\"})",
          "legendFormat": "{{master}} pending",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (master) (rate(hetzner_orphan_servers_reaped_total{master=~\"$master\"}[5m]))",
          "legendFormat": "{{master}} reap/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Anomaly counters (last 1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Increase over the last hour. CRW underflow + Uncaught are structural-fault canaries: any non-zero value indicates a code-level bug. Ghost nodes + DC failovers are routine events; small numbers are normal. Empty (no series) renders as 0.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
