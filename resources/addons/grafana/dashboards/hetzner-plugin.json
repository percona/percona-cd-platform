{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alarms",
        "type": "dashboard"
      }
    ]
  },
  "description": "Hetzner Cloud Jenkins plugin (v103.percona.13+): circuit breakers, provisioning latency, rate-limit headroom, API health, capacity vs cap, anomaly counters, and correlated SLF4J logs from /hetzner-prometheus and Loki. v2 (2026-05-12) fixes the idle-fleet success-rate gauge, the Loki level regex, the pending-vs-reap axis collision, the empty-stat label loss on anomaly counters, and adds API and capacity visibility.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "DC circuit breaker state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "0 = CLOSED (healthy), 1 = HALF_OPEN (probing), 2 = OPEN (skipping). One series per master/location.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20,
            "spanNulls": true
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CLOSED",
                  "color": "green"
                },
                "1": {
                  "text": "HALF_OPEN",
                  "color": "yellow"
                },
                "2": {
                  "text": "OPEN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "min": 0,
          "max": 2
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (master, location) (hetzner_dc_circuit_breaker_state{master=~\"$master\"})",
          "legendFormat": "{{master}} {{location}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Provisioning success rate (5m)",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Successful provisions / total provision attempts, last 5 minutes. Shows 'no attempts' (not red) when the fleet is idle.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "noValue": "no attempts"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum(rate(hetzner_provision_attempts_total{master=~\"$master\",outcome=\"success\"}[5m]))\n/\nsum(rate(hetzner_provision_attempts_total{master=~\"$master\"}[5m]))\nunless sum(rate(hetzner_provision_attempts_total{master=~\"$master\"}[5m])) == 0"
        }
      ]
    },
    {
      "id": 3,
      "title": "Provision latency p95 by template (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "95th percentile of hetzner_provision_duration_seconds_bucket, grouped by template label.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum by (template, le) (rate(hetzner_provision_duration_seconds_bucket{master=~\"$master\"}[5m])))",
          "legendFormat": "{{template}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "API rate-limit headroom",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Hetzner API requests remaining in the current rate-limit window. Threshold at 200 (typically 5 to 10 percent of full budget).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "green",
                "value": 500
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "min by (credentials_id, master) (hetzner_api_rate_limit_remaining{master=~\"$master\"})",
          "legendFormat": "{{master}} {{credentials_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pending provisions vs orphan reap rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "In-flight provisions (left axis, count) overlaid with orphan-server reap rate (right axis, events/sec). A growing gap suggests provision attempts are leaking.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisLabel",
                "value": "reap rate (events/sec)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "left"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisLabel",
                "value": "pending"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (master) (hetzner_provisioning_pending{master=~\"$master\"})",
          "legendFormat": "{{master}} pending",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (master) (rate(hetzner_orphan_servers_reaped_total{master=~\"$master\"}[5m]))",
          "legendFormat": "{{master}} reap/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Anomaly counters (last 1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Increase over the last hour. CRW underflow + Uncaught are structural-fault canaries: any non-zero value indicates a code-level bug. Ghost nodes + DC failovers are routine events; small numbers are normal. Empty (no series) renders as 0.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "short",
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum(increase(hetzner_provision_underflow_total{master=~\"$master\"}[1h]))",
          "legendFormat": "CRW underflow"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "B",
          "expr": "sum(increase(hetzner_provision_uncaught_exceptions_total{master=~\"$master\"}[1h]))",
          "legendFormat": "Uncaught"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "C",
          "expr": "sum(increase(hetzner_ghost_nodes_removed_total{master=~\"$master\"}[1h]))",
          "legendFormat": "Ghost nodes"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "D",
          "expr": "sum(increase(hetzner_dc_failover_total{master=~\"$master\"}[1h]))",
          "legendFormat": "DC failovers"
        }
      ]
    },
    {
      "id": 7,
      "title": "Hetzner-plugin log stream",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "SLF4J output from the patched plugin (HetznerCloud, NodeCallable, OrphanedNodesCleaner, DcCircuitBreaker, HetznerApiClient, RateLimitInterceptor, RetryInterceptor, TemplateErrorTracker). For ps3-k8s the stream is live today; for the EC2 masters it appears once the master-side Alloy systemd unit ships (Phase 2.5c).",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{master=~\"$master\"} |~ \"(c\\\\.d\\\\.j\\\\.p|cloud\\\\.dnation\\\\.jenkins\\\\.plugins)\\\\.hetzner\" | line_format \"[{{.master}}] {{ __line__ }}\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Log rate by level (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Message rate by JUL level. Jenkins logs in single-line tab-delimited format: `<date>+<tz> [id=N]\\t<LEVEL>\\t<class>#<method>: <msg>`. Header lines abbreviate the package to `c.d.j.p.hetzner.X`; stack traces keep the full FQCN. Filter matches both forms.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "legendFormat": "{{level}}",
          "expr": "sum by (level) (count_over_time({master=~\"$master\"} |~ \"(c\\\\.d\\\\.j\\\\.p|cloud\\\\.dnation\\\\.jenkins\\\\.plugins)\\\\.hetzner\" |~ \"\\t(SEVERE|WARNING|INFO|CONFIG|FINE)\\t\" | regexp `\\t(?P<level>SEVERE|WARNING|INFO|CONFIG|FINE)\\t` [5m]))"
        }
      ]
    },
    {
      "id": 100,
      "title": "API request rate by status class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Hetzner API request rate split by HTTP status class (2xx/4xx/5xx/network). Leading indicator before the rate-limit gauge moves during a Hetzner-side incident.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 100
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (master, status_class) (rate(hetzner_api_requests_total{master=~\"$master\"}[5m]))",
          "legendFormat": "{{master}} {{status_class}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 101,
      "title": "API latency p95 / p99 by method",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Per-method Hetzner API latency. Tells you whether boot-time slowness is Hetzner-side (this panel) vs launcher-side (panel 3 'provision latency') vs token-throttle (panel 4 'rate-limit headroom').",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 100
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (method, le) (rate(hetzner_api_request_duration_seconds_bucket{master=~\"$master\"}[5m])))",
          "legendFormat": "{{method}} p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (method, le) (rate(hetzner_api_request_duration_seconds_bucket{master=~\"$master\"}[5m])))",
          "legendFormat": "{{method}} p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 102,
      "title": "Provision skipped + leaked",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Why provisions are NOT happening (skipped by reason) and whether the plugin had to declare a server leaked (provisioned but never reached the launcher). Answers 'builds are queueing but nothing spawns'.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 200
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (reason) (rate(hetzner_provision_skipped_total{master=~\"$master\"}[5m]))",
          "legendFormat": "skipped: {{reason}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "B",
          "expr": "sum by (master, template) (rate(hetzner_provision_leaked_servers_total{master=~\"$master\"}[5m]))",
          "legendFormat": "leaked: {{master}} {{template}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "id": 103,
      "title": "Capacity: running / pending vs cap",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Per-master running and pending Hetzner workers with the configured cap as a dashed reference. Makes 'capacity exhausted' vs 'provisioning leaking' obvious at a glance.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 200
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (master) (hetzner_running_servers{master=~\"$master\"})",
          "legendFormat": "{{master}} running"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "B",
          "expr": "sum by (master) (hetzner_provisioning_pending{master=~\"$master\"})",
          "legendFormat": "{{master}} pending"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "C",
          "expr": "sum by (master) (hetzner_instance_cap{master=~\"$master\"})",
          "legendFormat": "{{master}} cap"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*cap$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 104,
      "title": "Plugin version per master",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Live Hetzner plugin version reported by each master via hetzner_plugin_info. Use this to confirm a fleet rollout has activated (busy masters retain the prior in-memory version until JVM restart).",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 300
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "hetzner_plugin_info{master=~\"$master\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "exported_master": true
            },
            "renameByName": {
              "master": "Master",
              "plugin_version": "Plugin version",
              "jenkins_baseline": "Jenkins baseline",
              "fork": "Fork"
            },
            "indexByName": {
              "master": 0,
              "plugin_version": 1,
              "jenkins_baseline": 2,
              "fork": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Master"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Plugin version"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^103\\.percona\\.14$",
                      "result": {
                        "color": "green",
                        "index": 0,
                        "text": "103.percona.14"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "hetzner",
    "jenkins",
    "lgtm",
    "ps-10997"
