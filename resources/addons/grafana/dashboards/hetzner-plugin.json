          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "definition": "label_values(hetzner_plugin_info, master)",
        "hide": 0,
        "includeAll": true,
        "label": "Master",
        "multi": true,
        "name": "master",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(hetzner_plugin_info, master)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
