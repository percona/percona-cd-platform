        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "max by (master, path) (avg_over_time(probe_success{job=~\"jenkins-uptime-.*\", master=~\"$master\"}[30d])) * 100",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Availability % (24h / 7d / 30d)",
      "transformations": [
        {
          "id": "merge",
