#!/bin/bash
# Rendered via templatefile(). Only master_profile=eks_observability
# is implemented; the gate exists so future variants can be added
# cleanly. See modules/jenkins-master/variables.tf.

JENKINS_HOST=${jenkins_host}
JENKINS_SHORT=${jenkins_short}
JENKINS_EIP=${eip_allocation_id}
JENKINS_VOLUME_ID=${data_volume_id}

# IMDSv2: the launch template sets http_tokens=required, so every direct
# IMDS call below negotiates a session token first. Token TTL=6h covers
# the boot path; nothing here reuses the token outside this script.
IMDS_TOKEN=$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
INSTANCE_ID=$(curl -fsS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
INSTANCE_REGION=$(curl -fsS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone | sed -e 's/[a-z]$//')

set -o xtrace
set -o errexit

setup_aws() {
%{ if eip_allocation_id != "" ~}
    aws ec2 associate-address \
        --region $INSTANCE_REGION \
        --instance-id $INSTANCE_ID \
        --allocation-id $JENKINS_EIP \
        --allow-reassociation
%{ else ~}
    # No managed EIP. SpotFleet picks a random public IP via
    # MapPublicIpOnLaunch=true. SSH is via paws+SSM; HTTPS via the ALB.
%{ endif ~}

    SPOT_REQUEST=$(
        aws ec2 describe-instances \
            --region $INSTANCE_REGION \
            --instance-ids $INSTANCE_ID \
            --query 'Reservations[].Instances[].SpotInstanceRequestId' \
            --output text
    )

    VOLUMES=$(
        aws ec2 describe-instances \
            --region $INSTANCE_REGION \
            --instance-ids $INSTANCE_ID \
            --query 'Reservations[].Instances[].BlockDeviceMappings[].Ebs.VolumeId' \
            --output text
    )

    aws ec2 create-tags \
        --resources $INSTANCE_ID $SPOT_REQUEST $VOLUMES \
        --region $INSTANCE_REGION \
        --tags Key=Name,Value=$JENKINS_SHORT \
               Key=iit-billing-tag,Value=$JENKINS_SHORT
}

retry() {
    local attempt=1
    until "$@"; do
        if [ $attempt -ge 5 ]; then
            echo "command failed after $attempt attempts: $*" >&2
            return 1
        fi
        echo "command failed (attempt $attempt), retrying: $*"
        attempt=$((attempt + 1))
        sleep 5
    done
}

install_software() {
    until yum makecache; do
        sleep 1
        echo try again
    done

    retry yum -y install yum-utils wget cronie rsync bc jq
    wget -O /etc/yum.repos.d/jenkins.repo https://pkg.jenkins.io/redhat-stable/jenkins.repo
    sed -i 's/^repo_gpgcheck=1/repo_gpgcheck=0/' /etc/yum.repos.d/jenkins.repo
    grep -q 'repo_gpgcheck=0' /etc/yum.repos.d/jenkins.repo
    rpm --import https://pkg.jenkins.io/redhat-stable/jenkins.io-2026.key
    retry yum -y install java-17-amazon-corretto
    retry yum -y update --security
    retry yum -y install jenkins-${jenkins_package_version} git dnf-automatic aws-cli xfsprogs

    sed -i 's/upgrade_type = default/upgrade_type = security/' /etc/dnf/automatic.conf
    sed -i 's/apply_updates = no/apply_updates = yes/'         /etc/dnf/automatic.conf
    echo "exclude=java-17-amazon-corretto* jenkins*" >> /etc/dnf/automatic.conf
    systemctl enable --now dnf-automatic.timer

    # amazon-ssm-agent ships preinstalled on STANDARD AL2023 but NOT on the
    # minimal AMI (amis.tf sources al2023-ami-minimal). Install + enable it so
    # the master is SSM-managed: EKS-fronted masters are administered via
    # paws/SSM (no inbound SSH), and SSM is the only OS access path.
    retry yum -y install amazon-ssm-agent
    systemctl enable --now amazon-ssm-agent

    # ec2-instance-connect is also absent on the minimal AMI. Installing it adds
    # the sshd AuthorizedKeysCommand so engineers can push a short-lived key via
    # EC2 Instance Connect instead of relying only on the static
    # ssh_key_engineers entries. It works over the SSM tunnel (AWS-StartSSHSession
    # to localhost:22), so it needs no inbound :22, and coexists with the static
    # AuthorizedKeysFile (sshd tries the file, then the command).
    retry yum -y install ec2-instance-connect
}

volume_state() {
    aws ec2 describe-volumes \
        --volume-id $JENKINS_VOLUME_ID \
        --region $INSTANCE_REGION \
        --query 'Volumes[].State' \
        --output text
}

mount_data_partition() {
    aws ec2 detach-volume \
        --region $INSTANCE_REGION \
        --volume-id $JENKINS_VOLUME_ID \
        || :
    while true; do
        [ "x$(volume_state)" = "xavailable" ] && break || sleep 1
    done

    aws ec2 attach-volume \
        --region $INSTANCE_REGION \
        --device /dev/xvdj \
        --instance-id $INSTANCE_ID \
        --volume-id $JENKINS_VOLUME_ID
    while true; do
        [ "x$(volume_state)" = "xin-use" ] && break || sleep 1
    done
    while true; do
        [ -e /dev/xvdj ] && break || sleep 1
    done

    if mkfs.xfs -L DATA /dev/xvdj; then
        FRESH_DATA_VOLUME=1
    else
        FRESH_DATA_VOLUME=0
    fi
    echo "/dev/xvdj /mnt xfs defaults,noatime,nofail 0 0" | tee -a /etc/fstab
    mount /mnt
}

start_jenkins() {
    sysctl net.ipv4.tcp_fin_timeout=15
    sysctl net.ipv4.tcp_tw_reuse=1
    sysctl net.ipv6.conf.all.disable_ipv6=1
    sysctl net.ipv6.conf.default.disable_ipv6=1
    cat <<-EOF | tee /etc/security/limits.d/jenkins.conf
		jenkins    soft    core      unlimited
		jenkins    hard    core      unlimited
		jenkins    soft    fsize     unlimited
		jenkins    hard    fsize     unlimited
		jenkins    soft    nofile    4096
		jenkins    hard    nofile    8192
		jenkins    soft    nproc     30654
		jenkins    hard    nproc     30654
	EOF

    install -o jenkins -g jenkins -d /mnt/$JENKINS_HOST
    install -o jenkins -g jenkins -d /mnt/$JENKINS_HOST/init.groovy.d
    install -o jenkins -g jenkins -d /var/log/jenkins
    # A full recursive chown of JENKINS_HOME over millions of inodes adds
    # ~13 min to every spot replacement (PKG-1335). The persistent data
    # volume is already jenkins-owned from prior boots, so only walk it on a
    # genuinely fresh volume (mkfs.xfs succeeded in mount_data_partition).
    # /var/log/jenkins is freshly created above by install -o, so it needs
    # no recursive walk.
    if [ "$FRESH_DATA_VOLUME" = "1" ]; then
        echo "fresh data volume; running full recursive chown of JENKINS_HOME"
        chown -hR jenkins:jenkins /mnt/$JENKINS_HOST
    fi

    printf "127.0.0.1 $(hostname) $(hostname -A)\n10.30.6.220 vbox-01.ci.percona.com\n10.30.6.9 repo.ci.percona.com\n" \
        | tee -a /etc/hosts
    mkdir -p /etc/systemd/system/jenkins.service.d
    cat <<-EOF | tee /etc/systemd/system/jenkins.service.d/override.conf
		[Service]
		TimeoutStartSec=600
		# Directory where Jenkins stores its configuration and workspaces
		Environment="JENKINS_HOME=/mnt/$JENKINS_HOST"
		WorkingDirectory=/mnt/$JENKINS_HOST

		# Location of the exploded WAR
		Environment="JENKINS_WEBROOT=/var/cache/jenkins/war"

		# Location of the Jenkins log.
		Environment="JENKINS_LOG=/var/log/jenkins/jenkins.log"
	EOF

%{ if master_profile == "eks_observability" ~}
    cat <<-"EOF" | tee -a /etc/systemd/system/jenkins.service.d/override.conf

		# Arguments for the Jenkins JVM. The -Dhetzner.rehydrate.* flags
		# enable Hetzner worker re-adoption on JVM restart so stranded
		# Hetzner VMs from a crash are picked back up instead of reaped
		# by OrphanedNodesCleaner during the 5-minute defer window.
		Environment="JAVA_OPTS=-Djava.awt.headless=true ${jvm_memory_opts} -server -Dorg.jenkinsci.plugins.durabletask.BourneShellScript.HEARTBEAT_CHECK_INTERVAL=600 -Dhetzner.rehydrate.enabled=true -Dhetzner.rehydrate.grace-period-minutes=5"
	EOF
%{ endif ~}

    systemctl daemon-reload
    systemctl enable jenkins
    systemctl start --no-block jenkins

%{ if master_profile == "eks_observability" ~}
    # PS-11173 Phase 3: graceful spot-interrupt drain. Replaces the
    # immediate `systemctl stop jenkins` with a quietDown + busyExecutors
    # poll + safeExit flow that uses up to ~85s of the AWS 120s warning.
    # Admin token is fetched per-run from AWS Secrets Manager via the
    # AdminApiTokenRead IAM grant; no token on disk.
    install -m 0755 /dev/stdin /usr/local/bin/jenkins-graceful-stop.sh <<'GRACEFUL'
#!/bin/bash
# Gracefully drain Jenkins on AWS spot interrupt. Triggered by
# /etc/cron.d/terminate-check at 30s cadence; the script self-checks
# the spot/instance-action IMDS endpoint and exits silently when
# there's no interrupt pending.
set -u

# IMDSv2: the launch template requires session tokens. 60s TTL is plenty
# for one drain pass.
IMDS_TOKEN=$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60") || exit 0

# Self-check: is there an active spot interrupt? Non-200 means no
# (404 in the normal case; we exit 0 so cron stays quiet).
SPOT_CODE=$(curl -fsS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" -o /dev/null -w "%%{http_code}" "http://169.254.169.254/latest/meta-data/spot/instance-action" || echo 000)
[ "$SPOT_CODE" = "200" ] || exit 0

# flock prevents the every-30s cron from piling up duplicate drains
# while a previous run is still polling busyExecutors.
exec 9>/run/jenkins-graceful-stop.lock
flock -n 9 || { echo "graceful-stop: another drain is already running, skipping" >&2; exit 0; }

INSTANCE_REGION=$(curl -fsS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone | sed -e 's/[a-z]$//')
TOKEN=$(aws secretsmanager get-secret-value \
    --region "$INSTANCE_REGION" \
    --secret-id ps3.cd/jenkins/admin-api-token \
    --query SecretString --output text) || {
    echo "graceful-stop: SM fetch failed; falling back to systemctl stop" >&2
    systemctl stop jenkins
    cp /var/log/jenkins/jenkins.log /mnt/jenkins-latest.log || true
    umount /mnt || true
    exit 0
}
USER="api-admin"
BASE="http://127.0.0.1:8080"
curl -fsS -u "$USER:$TOKEN" -X POST \
    "$BASE/quietDown?reason=EC2%20Spot%20interruption" || true
deadline=$(( $(date +%s) + 85 ))
while [ "$(date +%s)" -lt "$deadline" ]; do
    busy=$(curl -fsS -u "$USER:$TOKEN" "$BASE/computer/api/json?tree=busyExecutors" \
           | jq -r '.busyExecutors // 0') || busy=0
    [ "$busy" -le 0 ] && break
    echo "graceful-stop: busyExecutors=$busy (deadline in $((deadline - $(date +%s)))s)" >&2
    sleep 3
done
curl -fsS -u "$USER:$TOKEN" -X POST "$BASE/safeExit" || true
sleep 5
cp /var/log/jenkins/jenkins.log /mnt/jenkins-latest.log || true
umount /mnt || true
GRACEFUL

    # 30s polling cadence (minute boundary + offset 30s). The script
    # self-checks the spot-action IMDS endpoint and exits 0 when no
    # interrupt is pending; flock inside the script gates concurrency.
    printf "* * * * * root /usr/local/bin/jenkins-graceful-stop.sh\n* * * * * root sleep 30; /usr/local/bin/jenkins-graceful-stop.sh\n" > /etc/cron.d/terminate-check
%{ endif ~}

    # cronie ships disabled on AL2023; the terminate-check cron only
    # fires once the daemon is enabled+started. Without this, the spot
    # interrupt watcher never runs (root cause of PS-11173 FIS round 1).
    systemctl enable --now crond
}

setup_ssh_keys() {
    KEYS_LIST="${ssh_key_engineers}"
    for KEY in $KEYS_LIST; do
        RETRY="3"
        while [ $RETRY != "0" ]; do
            STATUS=$(curl -Is https://www.percona.com/get/engineer/KEY/$KEY.pub | head -n1 | awk '{print $2}')
            if [[ $STATUS -eq 200 ]]; then
                curl -s https://www.percona.com/get/engineer/KEY/$KEY.pub | tee -a /home/ec2-user/.ssh/authorized_keys
                RETRY="0"
            elif [[ $STATUS -eq 404 ]]; then
                echo "Skipping key $KEY"
                RETRY=0
            else
                echo "Got $STATUS, retrying"
                RETRY=$(($RETRY-1))
            fi
        done
    done
}

%{ if plugin_install_hook != "" ~}
install_plugins_hook() {
    # First-boot plugins.groovy pinning (pxc-style).
    wget -O /mnt/$JENKINS_HOST/init.groovy.d/plugins.groovy ${plugin_install_hook}
    chown jenkins:jenkins /mnt/$JENKINS_HOST/init.groovy.d/plugins.groovy
}
%{ endif ~}

%{ if length(init_groovy_hooks) > 0 ~}
install_init_groovy_hooks() {
    # Declarative init.groovy.d wiring fetched from pinned sources at boot.
    # Closes the bootstrap gap: a fresh-volume rebuild re-materializes the
    # master's full wiring set instead of relying on the carried-forward EBS
    # data volume. A failed fetch warns but never blocks boot. `jenkins iac
    # deploy` remains the no-restart hot-reload path for live edits.
%{ for fname, furl in init_groovy_hooks ~}
    wget -O "/mnt/$JENKINS_HOST/init.groovy.d/${fname}" "${furl}" \
        && chown jenkins:jenkins "/mnt/$JENKINS_HOST/init.groovy.d/${fname}" \
        || echo "WARN: failed to fetch init.groovy.d/${fname} from ${furl}"
%{ endfor ~}
}
%{ endif ~}

%{ if init_groovy_s3_bucket != "" ~}
install_init_groovy_files() {
    # Declarative init.groovy.d wiring pulled from the module-created S3
    # bucket at boot. The repo is the source of truth (objects are uploaded
    # by Terraform), so a fresh-volume rebuild re-materializes the master's
    # full wiring set instead of relying on the carried-forward EBS data
    # volume. Transits the S3 gateway VPC endpoint (same-region bucket). A
    # failed fetch warns but never blocks boot. `jenkins iac deploy` remains
    # the no-restart hot-reload path for live edits.
%{ for fname in init_groovy_files ~}
    aws s3 cp "s3://${init_groovy_s3_bucket}/init.groovy.d/${fname}" "/mnt/$JENKINS_HOST/init.groovy.d/${fname}" --region "$INSTANCE_REGION" \
        && chown jenkins:jenkins "/mnt/$JENKINS_HOST/init.groovy.d/${fname}" \
        || echo "WARN: failed to fetch init.groovy.d/${fname} from s3://${init_groovy_s3_bucket}"
%{ endfor ~}
}
%{ endif ~}

main() {
    setup_aws
    setup_ssh_keys
    mount_data_partition
    install_software
%{ if plugin_install_hook != "" ~}
    install_plugins_hook
%{ endif ~}
%{ if length(init_groovy_hooks) > 0 ~}
    install_init_groovy_hooks
%{ endif ~}
%{ if init_groovy_s3_bucket != "" ~}
    install_init_groovy_files
%{ endif ~}
    start_jenkins
%{ if master_profile == "eks_observability" ~}
    # Wires master-side Alloy into the alloy-gateway. The script is now
    # vendored in this repo at scripts/install-master-observability.sh;
    # SHA-pinned so a script edit + a userdata edit land in one diff
    # and the boot path is reproducible. CFN-managed masters still
    # fetch the same content from a thin pass-through at
    # Percona-Lab/jenkins-pipelines/scripts/install-master-observability.sh
    # until they migrate to TF.
    curl -fsSL --retry 5 https://raw.githubusercontent.com/percona/percona-cd-platform/6f5346eadc4bfa44e6d86d73ceb62ce7efbb7b79/scripts/install-master-observability.sh | JENKINS_HOST="$JENKINS_HOST" bash
%{ endif ~}
}

main
exit 0
