# Local-only overrides for OpenTofu. Copy to local.auto.tfvars (gitignored)
# and edit. Anything you put here lands in tofu plan automatically.
#
# `cp local.auto.tfvars.example local.auto.tfvars`

# AWS profile: do NOT set `aws_profile` here.
#
# Credential selection is owned by the AWS_PROFILE environment variable, which
# the justfile reads and injects into every AWS-touching recipe (tf-plan,
# tf-apply, tf-destroy, ...). Setting aws_profile in local.auto.tfvars creates a
# split-brain: a tfvars value silently overrides the env var inside `tofu`, so
# `AWS_PROFILE=X just tf-plan` would plan against profile Y. Leave it unset and
# providers.tf falls through to the SDK default chain (the AWS_PROFILE you export).
#   export AWS_PROFILE=percona-dev-admin   # in your shell, NOT here.

# Override only if you want a different region or hostname for a fork/dev cluster.
#aws_region        = "us-east-1"
#cluster_name      = "percona-ci-platform"
#argocd_hostname   = "argocd.cd.percona.com"
#grafana_hostname  = "grafana.cd.percona.com"

# OPTIONAL, additive override for the EKS public-API allowlist
# (docs/eks-hardening.md #2). The baseline lives in SSM parameter
# /<cluster>/allowlist/eks-api, managed via `just allowlist-set` (see
# docs/runbooks/eks-api-access.md). Set this only for emergency access
# while the parameter catches up; 0.0.0.0/0 is rejected by validation.
#api_public_access_cidrs = [
#  "198.51.100.5/32", # emergency operator egress
#]

# OPTIONAL, extra EKS access entries (docs/eks-hardening.md #1), merged on
# top of the committed baseline: eks.tf resolves the IAM Identity Center
# AdministratorAccess role dynamically, so day-to-day cluster admin needs no
# entry here. Add break-glass or extra principals only.
#access_entries = {
#  breakglass = {
#    principal_arn = "arn:aws:iam::<account>:user/<user>"
#    policy_associations = {
#      admin = {
#        policy_arn   = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
#        access_scope = { type = "cluster" }
#      }
#    }
#  }
#}

# Authentik SAML bridge (JumpCloud via Authentik). The committed default is
# true and matches the live cluster, so leave this unset. Set false only to
# boot a fresh cluster before the SP cert/key and IdP metadata exist, or to
# roll the bridge back. Runbook: docs/runbooks/authentik-bootstrap.md
#authentik_saml_enabled = false
